--============================================================
local PLATFORM_ROWS = { "Right Platforms", "Left Platforms" }

local ZONE_TABLE = {
    ["Right Platforms"] = {
        ["1v1"] = { Zone = "PadZone1", Main = "Pad1", Alt = "Pad2" },
        ["2v2"] = { Zone = "PadZone2", Main = "Pad1", Alt = "Pad2" },
        ["3v3"] = { Zone = "PadZone3", Main = "Pad1", Alt = "Pad2" },
        ["4v4"] = { Zone = "PadZone4", Main = "Pad1", Alt = "Pad2" },
    },
    ["Left Platforms"] = {
        ["1v1"] = { Zone = "PadZone5", Main = "Pad1", Alt = "Pad2" },
        ["2v2"] = { Zone = "PadZone6", Main = "Pad1", Alt = "Pad2" },
        ["3v3"] = { Zone = "PadZone7", Main = "Pad1", Alt = "Pad2" },
        ["4v4"] = { Zone = "PadZone8", Main = "Pad1", Alt = "Pad2" },
    },
}

local function GetPadFromZone(zoneName, padName)
    local padZones = workspace:FindFirstChild("PadZones")
    if not padZones then return nil end
    local zone = padZones:FindFirstChild(zoneName)
    if not zone then return nil end
    local holder = zone:FindFirstChild(padName)
    if not holder then return nil end
    local pad = holder:FindFirstChild("Pad")
    if pad and pad:IsA("BasePart") then return pad end
    return nil
end

local function IsInsidePad(position, pad, tolerance)
    if not (position and pad and pad:IsA("BasePart")) then return false end
    tolerance = tonumber(tolerance) or 0
    local localPos = pad.CFrame:PointToObjectSpace(position)
    local half = pad.Size / 2
    return math.abs(localPos.X) <= (half.X + tolerance)
        and math.abs(localPos.Z) <= (half.Z + tolerance)
        and localPos.Y >= -(half.Y + 6)
        and localPos.Y <= (half.Y + 14)
end

--============================================================
--  AUTO TELEPORT
--============================================================
local AutoTeleport = {}
AutoTeleport.__index = AutoTeleport
function AutoTeleport.new(role)
    return setmetatable({
        role = role, running = false, tickConn = nil,
        cooldown = 0, COOLDOWN = 0.5,
        _lastPad = nil, _lastPadColors = nil,
    }, AutoTeleport)
end
function AutoTeleport:getTargetPad()
    local row = Config.PlatformRow
    local duel = Config.DuelType
    local entry = ZONE_TABLE[row] and ZONE_TABLE[row][duel]
    if not entry then entry = ZONE_TABLE["Right Platforms"]["1v1"] end
    local padName = (self.role == "Alt") and entry.Alt or entry.Main
    return GetPadFromZone(entry.Zone, padName), entry.Zone, padName
end
function AutoTeleport:isEnabled()
    if self.role == "Main" then return Config.AutoTeleportMain == true end
    return Config.AutoTeleportAlt == true
end
function AutoTeleport:isInMatch()
    local g = LocalPlayer:GetAttribute("Game")
    return typeof(g) == "string" and g ~= ""
end
function AutoTeleport:tick(dt)
    if not self.running or not self:isEnabled() then return end
    if self:isInMatch() then return end
    self.cooldown = self.cooldown + dt
    if self.cooldown < self.COOLDOWN then return end
    self.cooldown = 0
    local pad = self:getTargetPad()
    if not pad then return end
    self:applyPadHighlight(pad)
    local myHRP = GetHRP(LocalPlayer)
    if myHRP and IsInsidePad(myHRP.Position, pad, 0.5) then return end
    local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if myHRP and myHum then
        pcall(function()
            myHRP.AssemblyAngularVelocity = Vector3.zero
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHum:MoveTo(pad.Position)
        end)
    end
end
function AutoTeleport:applyPadHighlight(pad)
    if self._lastPad ~= pad then
        self:restorePadHighlight()
        self._lastPad = pad
        self._lastPadColors = { Color = pad.Color, Transparency = pad.Transparency }
    end
    local color = (self.role == "Alt") and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(70, 145, 255)
    pcall(function() pad.Color = color pad.Transparency = 0.5 end)
end
function AutoTeleport:restorePadHighlight()
    if self._lastPad and self._lastPadColors and self._lastPad.Parent then
        pcall(function()
            self._lastPad.Color = self._lastPadColors.Color
            self._lastPad.Transparency = self._lastPadColors.Transparency
        end)
    end
    self._lastPad = nil
    self._lastPadColors = nil
end
function AutoTeleport:start()
    if self.running then return end
    self.running = true
    self.cooldown = 0
    local pad = self:getTargetPad()
    if pad then self:applyPadHighlight(pad) end
    self.tickConn = RunService.Heartbeat:Connect(function(dt) self:tick(dt) end)
end
function AutoTeleport:stop()
    if not self.running then return end
    self.running = false
    if self.tickConn then self.tickConn:Disconnect() self.tickConn = nil end
    self:restorePadHighlight()
end

--============================================================
--  BREAK STREAK
--============================================================
local BreakStreak = {}
BreakStreak.__index = BreakStreak
function BreakStreak.new()
    return setmetatable({ running = false, tickConn = nil, cooldown = 0, COOLDOWN = 1 }, BreakStreak)
end
function BreakStreak:getStreak(player)
    local streak = player:FindFirstChild("Streak")
    if streak and (streak:IsA("IntValue") or streak:IsA("NumberValue")) then
        return tonumber(streak.Value)
    end
    local hrp = GetHRP(player)
    local headTag = hrp and hrp:FindFirstChild("HeadTag")
    local streakFolder = headTag and headTag:FindFirstChild("Streak")
    local label = streakFolder and streakFolder:FindFirstChild("TextLabel")
    if label then
        local txt = tostring(label.Text or ""):gsub("[^%d%-]", "")
        return tonumber(txt)
    end
    return nil
end
function BreakStreak:isInMatch() return hasGameAndMap(LocalPlayer) end
function BreakStreak:shouldSkip(player)
    if not EnemyChecker:isEnemy(player) then return true end
    if not IsAlive(player) then return true end
    local target = Config.BreakStreakTarget or 1
    local playerStreak = self:getStreak(player)
    if not playerStreak or playerStreak < target then return true end
    return false
end
function BreakStreak:sendBreakStreak(player)
    local net = getRemotes()
    local rf = net and net:FindFirstChild("RE/Match/SetStatePlr")
    if rf and rf:IsA("RemoteEvent") then
        pcall(function() rf:FireServer("REMOVE") end)
        return true
    end
    return false
end
function BreakStreak:tick(dt)
    if not self.running or not Config.BreakStreakEnabled then return end
    if not self:isInMatch() then return end
    self.cooldown = self.cooldown + dt
    if self.cooldown < self.COOLDOWN then return end
    self.cooldown = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if not self:shouldSkip(player) then
            if self:sendBreakStreak(player) then break end
        end
    end
end
function BreakStreak:start()
    if self.running then return end
    self.running = true
    self.cooldown = 0
    self.tickConn = RunService.Heartbeat:Connect(function(dt) self:tick(dt) end)
end
function BreakStreak:stop()
    if not self.running then return end
    self.running = false
    if self.tickConn then self.tickConn:Disconnect() self.tickConn = nil end
end

