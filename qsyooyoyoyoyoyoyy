--  LOWER KD
--============================================================
local LowerKD = {}
LowerKD.__index = LowerKD
function LowerKD.new()
    return setmetatable({ running = false, tickConn = nil, cooldown = 0, COOLDOWN = 1 }, LowerKD)
end
function LowerKD:getKills(player)
    local attr = tonumber(player:GetAttribute("RoundKills"))
    if attr then return attr end
    local kills = player:FindFirstChild("RoundKills")
    if kills and (kills:IsA("IntValue") or kills:IsA("NumberValue")) then
        return tonumber(kills.Value) or 0
    end
    local ls = player:FindFirstChild("leaderstats")
    local lsKills = ls and ls:FindFirstChild("RoundKills")
    if lsKills and (lsKills:IsA("IntValue") or lsKills:IsA("NumberValue")) then
        return tonumber(lsKills.Value) or 0
    end
    return nil
end
function LowerKD:isInMatch() return hasGameAndMap(LocalPlayer) end
function LowerKD:tick(dt)
    if not self.running or not Config.LowerKDEnabled then return end
    if not self:isInMatch() then return end
    self.cooldown = self.cooldown + dt
    if self.cooldown < self.COOLDOWN then return end
    self.cooldown = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if EnemyChecker:isEnemy(player) and IsAlive(player) then
            local kills = self:getKills(player)
            if kills and kills >= (Config.LowerKDTarget or 4) then
                local hrp = GetHRP(player)
                if hrp and CanSee(player, hrp) then
                    pcall(function()
                        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                    end)
                    break
                end
            end
        end
    end
end
function LowerKD:start()
    if self.running then return end
    self.running = true
    self.cooldown = 0
    self.tickConn = RunService.Heartbeat:Connect(function(dt) self:tick(dt) end)
end
function LowerKD:stop()
    if not self.running then return end
    self.running = false
    if self.tickConn then self.tickConn:Disconnect() self.tickConn = nil end
end

--============================================================
--  AUTO KILL ALL
--============================================================
local KillAll = {}
KillAll.__index = KillAll
function KillAll.new()
    return setmetatable({
        running = false, tickConn = nil, cooldown = 0, killed = 0, failed = 0,
    }, KillAll)
end
function KillAll:isInMatch() return hasGameAndMap(LocalPlayer) end
function KillAll:canKill(player)
    if not EnemyChecker:isEnemy(player) then return false end
    if not IsAlive(player) then return false end
    local myHRP = GetHRP(LocalPlayer)
    local hisHRP = GetHRP(player)
    if not (myHRP and hisHRP) then return false end
    local dist = (myHRP.Position - hisHRP.Position).Magnitude
    if dist > (Config.KillAllRange or 500) then return false end
    if Config.KillAllRequireLOS and not CanSee(player, hisHRP) then return false end
    return true
end
function KillAll:killPlayer(player)
    local rf = getKnifeKillRemote()
    if not rf then return false end
    local hisChar = player.Character
    if not hisChar then return false end
    local hisHum = hisChar:FindFirstChildOfClass("Humanoid")
    local hisHRP = GetHRP(player)
    local ok = pcall(function()
        if hisHum then rf:FireServer(hisHum) return end
        if hisHRP then rf:FireServer(hisHRP) return end
        rf:FireServer()
    end)
    return ok
end
function KillAll:tick(dt)
    if not self.running or not Config.KillAllEnabled then return end
    if not self:isInMatch() then return end
    self.cooldown = self.cooldown + dt
    if self.cooldown < (Config.KillAllCooldown or 0.1) then return end
    self.cooldown = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if self:canKill(player) then
            if self:killPlayer(player) then
                self.killed = self.killed + 1
            else
                self.failed = self.failed + 1
            end
        end
    end
end
function KillAll:start()
    if self.running then return end
    self.running = true
    self.cooldown = 0
    self.tickConn = RunService.Heartbeat:Connect(function(dt) self:tick(dt) end)
end
function KillAll:stop()
    if not self.running then return end
    self.running = false
    if self.tickConn then self.tickConn:Disconnect() self.tickConn = nil end
end

--============================================================
--  ⭐ STREAK FARM (NUEVO)
--  Sistema coordinado de 2 cuentas:
--   - Farmer: mata a la víctima en loop
--   - Victim: se deja matar y espera al lobby
--============================================================
local StreakFarm = {}
StreakFarm.__index = StreakFarm

function StreakFarm.new()
    return setmetatable({
        running = false,
        tickConn = nil,
        state = "idle",              -- "idle" / "waiting_match" / "in_match" / "post_match"
        lastMatchState = false,      -- si estaba en partida en el tick anterior
        matchStartTime = 0,
        matchKills = 0,
        totalRounds = 0,
        totalKills = 0,
        cooldown = 0,
    }, StreakFarm)
end

function StreakFarm:getRole()
    return Config.StreakFarmRole
end

function StreakFarm:isInMatch()
    local g = LocalPlayer:GetAttribute("Game")
    return typeof(g) == "string" and g ~= ""
end

-- Cuenta las kills del round actual (para farmer)
function StreakFarm:getMyKills()
    local attr = tonumber(LocalPlayer:GetAttribute("RoundKills"))
    if attr then return attr end
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    local k = ls and ls:FindFirstChild("RoundKills")
    if k and (k:IsA("IntValue") or k:IsA("NumberValue")) then
        return tonumber(k.Value) or 0
    end
    return nil
end

--============================================================
--  ROL: FARMER
--============================================================
function StreakFarm:tickFarmer(dt)
    -- Si no está en partida → esperando
    if not self:isInMatch() then
        -- Vuelve al pad si AutoTeleport está activo
        return
    end

    -- En partida: matar a TODOS los enemigos (la víctima entre ellos)
    self.matchKills = self:getMyKills() or self.matchKills

    -- Activa Kill All automáticamente si está configurado
    if Config.StreakFarmAutoKill and not Config.KillAllEnabled then
        Config.KillAllEnabled = true
        killAll:start()

        WindUI:Notify({
            Title = "Streak Farm",
            Content = "Partida detectada — Kill All activado.",
            Icon = "play",
            Duration = 3,
        })
    end

    -- Si alcanzó el máximo de kills por ronda, apaga Kill All
    if Config.StreakFarmMaxKills > 0 and self.matchKills >= Config.StreakFarmMaxKills then
        if Config.KillAllEnabled then
            Config.KillAllEnabled = false
            killAll:stop()
            WindUI:Notify({
                Title = "Streak Farm",
                Content = ("Límite alcanzado (%d kills) — esperando fin de ronda."):format(self.matchKills),
                Icon = "check",
                Duration = 3,
            })
        end
    end
end

--============================================================
--  ROL: VICTIM
--============================================================
function StreakFarm:tickVictim(dt)
    -- Si no está en partida → esperando en el pad
    if not self:isInMatch() then
        return
    end

    -- En partida: quedarse quieto
    local myHRP = GetHRP(LocalPlayer)
    if myHRP then
        pcall(function()
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    -- Asegurarse que Kill All NO esté activo
    if Config.KillAllEnabled then
        Config.KillAllEnabled = false
        killAll:stop()
    end

    -- Asegurarse que KillAllKeepOn NO esté activo
    if Config.KillAllKeepOn then
        Config.KillAllKeepOn = false
    end
end

--============================================================
--  CICLO PRINCIPAL
--============================================================
function StreakFarm:tick(dt)
    if not self.running then return end
    if not Config.StreakFarmEnabled then return end

    local role = self:getRole()
    if role == "off" then return end

    local nowInMatch = self:isInMatch()

    -- Detección de transición lobby → partida
    if nowInMatch and not self.lastMatchState then
        -- Entramos a partida
        self.matchStartTime = os.clock()
        self.matchKills = 0
        self.totalRounds = self.totalRounds + 1

        WindUI:Notify({
            Title = "Streak Farm",
            Content = ("Entraste a partida (Ronda #%d) — Rol: %s"):format(
                self.totalRounds,
                role == "farmer" and "Farmer" or "Víctima"
            ),
            Icon = "play",
            Duration = 4,
        })
    end

    -- Detección de transición partida → lobby
    if not nowInMatch and self.lastMatchState then
        -- Terminó la partida
        local killsThisRound = self.matchKills

        WindUI:Notify({
            Title = "Streak Farm",
            Content = ("Ronda #%d terminada (%d kills). Esperando %ds..."):format(
                self.totalRounds,
                killsThisRound,
                Config.StreakFarmLobbyWait
            ),
            Icon = "check",
            Duration = 4,
        })

        -- Apagar Kill All (por si acaso)
        if Config.KillAllEnabled then
            Config.KillAllEnabled = false
            killAll:stop()
        end

        -- Espera en el lobby
        task.spawn(function()
            task.wait(Config.StreakFarmLobbyWait)
            -- El AutoTeleport se encargará de volver al pad
        end)

        self.matchKills = 0
    end

    self.lastMatchState = nowInMatch

    -- Ejecutar el tick según el rol
    if role == "farmer" then
        self:tickFarmer(dt)
    elseif role == "victim" then
        self:tickVictim(dt)
    end
end

function StreakFarm:start()
    if self.running then return end
    self.running = true
    self.state = "idle"
    self.lastMatchState = self:isInMatch()
    self.totalRounds = 0
    self.totalKills = 0

    self.tickConn = RunService.Heartbeat:Connect(function(dt)
        self:tick(dt)
    end)

    -- Auto-activar AutoTeleport según el rol
    if self:getRole() == "farmer" then
        Config.AutoTeleportMain = true
        Config.AutoTeleportAlt = false
        autoTPAlt:stop()
        autoTPMain:start()
    elseif self:getRole() == "victim" then
        Config.AutoTeleportAlt = true
        Config.AutoTeleportMain = false
        autoTPMain:stop()
        autoTPAlt:start()
    end
end

function StreakFarm:stop()
    if not self.running then return end
    self.running = false
    if self.tickConn then
        self.tickConn:Disconnect()
        self.tickConn = nil
    end
    -- Apagar Kill All
    if Config.KillAllEnabled then
        Config.KillAllEnabled = false
        killAll:stop()
    end
end

