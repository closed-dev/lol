--  EVENT FARM
--============================================================
local function GetEventDropPart(drop)
    if not drop or not drop.Parent then return nil end
    local touch = drop:FindFirstChild("Touch", true)
    if touch and touch:IsA("BasePart") then return touch end
    for _, child in ipairs(drop:GetDescendants()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

local EventFarm = {}
EventFarm.__index = EventFarm
function EventFarm.new()
    return setmetatable({
        running = false, tickConn = nil, tickAccum = 0, TICK_RATE = 0.5, collected = 0,
    }, EventFarm)
end
function EventFarm:collectDrops()
    local myHRP = GetHRP(LocalPlayer)
    if not myHRP then return end
    local spawnables = workspace:FindFirstChild("SpawnablesClient")
    if not spawnables then return end
    for _, drop in ipairs(spawnables:GetChildren()) do
        local part = GetEventDropPart(drop)
        if part and part:IsA("BasePart") then
            local ok = pcall(function()
                firetouchinterest(myHRP, part, 0)
                firetouchinterest(myHRP, part, 1)
            end)
            if ok then self.collected = self.collected + 1
            else pcall(function() myHRP.CFrame = CFrame.new(part.Position) end) end
        end
    end
end
function EventFarm:tick(dt)
    if not self.running or not Config.EventFarmEnabled then return end
    self.tickAccum = self.tickAccum + dt
    if self.tickAccum < self.TICK_RATE then return end
    self.tickAccum = 0
    self:collectDrops()
end
function EventFarm:start()
    if self.running then return end
    self.running = true
    self.tickAccum = 0
    self.tickConn = RunService.Heartbeat:Connect(function(dt) self:tick(dt) end)
end
function EventFarm:stop()
    if not self.running then return end
    self.running = false
    if self.tickConn then self.tickConn:Disconnect() self.tickConn = nil end
end

