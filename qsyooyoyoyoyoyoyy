--============================================================
--  ANTI-TAMPER
--============================================================
local CleanupKey = "__evt_kx"
local GenKey     = "__evt_gn"
local GenCounter = 1

pcall(function()
    local genv = getgenv_()
    if type(genv[CleanupKey]) == "function" then genv[CleanupKey]() end
    GenCounter = (tonumber(genv[GenKey]) or 0) + 1
    genv[GenKey] = GenCounter
end)

local function IsValidGen()
    local ok, cur = pcall(function() return getgenv_()[GenKey] end)
    if not ok then return true end
    return cur == nil or cur == GenCounter
end

--============================================================
--  UTILIDADES
--============================================================
local function GetHRP(player)
    local char = player and player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("Head")
    if hrp and hrp:IsA("BasePart") then return hrp end
    return nil
end

local function IsAlive(player)
    local char = player and player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function hasAttr(inst, name)
    if not inst then return false end
    local val = inst:GetAttribute(name)
    return typeof(val) == "string" and val ~= ""
end

local function hasGameAndMap(player)
    return hasAttr(player, "Game") and hasAttr(player, "Map")
end

local function isWhitelisted(player)
    for _, id in ipairs(WhitelistUserIds) do
        if player.UserId == id then return true end
    end
    return false
end

--============================================================
--  ENEMY CHECKER
--============================================================
local EnemyChecker = {}
function EnemyChecker:isEnemy(player)
    if player == LocalPlayer then return false end
    if isWhitelisted(player) then return false end
    if not hasGameAndMap(LocalPlayer) or not hasGameAndMap(player) then return false end
    if LocalPlayer:GetAttribute("Game") ~= player:GetAttribute("Game") then return false end
    if LocalPlayer:GetAttribute("Map")  ~= player:GetAttribute("Map")  then return false end
    local myTeam  = LocalPlayer:GetAttribute("Team")
    local hisTeam = player:GetAttribute("Team")
    if typeof(myTeam) ~= "string" or myTeam == "" then return false end
    if typeof(hisTeam) ~= "string" or hisTeam == "" then return false end
    return myTeam ~= hisTeam
end

--============================================================
--  RAYCAST
--============================================================
local cachedRayParams, cachedRayParamsChar = nil, false
local function GetRayParams(char)
    if cachedRayParams and cachedRayParamsChar == char then return cachedRayParams end
    local rp = cachedRayParams
    if not rp then
        rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.IgnoreWater = true
        cachedRayParams = rp
    end
    rp.FilterDescendantsInstances = char and { char } or {}
    cachedRayParamsChar = char
    return rp
end

local function CanSee(player, part)
    local myChar  = LocalPlayer.Character
    local myHRP   = GetHRP(LocalPlayer)
    local hisChar = player and player.Character
    if not (myChar and myHRP and hisChar and part and part:IsA("BasePart")) then return false end
    local delta = part.Position - myHRP.Position
    if delta.Magnitude <= 0 then return false end
    local hit = workspace:Raycast(myHRP.Position, delta, GetRayParams(myChar))
    return (not hit) or (hit.Instance and hit.Instance:IsDescendantOf(hisChar))
end

--============================================================
--  REMOTES
--============================================================
local function getRemotes()
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    local net = packages and packages:FindFirstChild("Networking")
    return net
end

local function getKnifeKillRemote()
    local net = getRemotes()
    if not net then return nil end
    local rf = net:FindFirstChild("RE/Combat/KnifeKill")
    if rf and rf:IsA("RemoteEvent") then return rf end
    for _, child in ipairs(net:GetDescendants()) do
        if child:IsA("RemoteEvent") and string.find(child.Name, "KnifeKill", 1, true) then
            return child
        end
    end
    return nil
end

